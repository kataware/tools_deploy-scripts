# サンプル設定ファイル（各プロジェクトのリポジトリ直下に `.deploy` として配置する）
#
# deploy.sh が実際に読むキーは以下の8つのみ（これが設定できる項目の全て）:
#
# - host          : 接続先ホスト名/IP。ssh にそのまま渡される。~/.ssh/config のHostエイリアスでも可
# - user          : 省略可。接続ユーザー名。指定すると host の前に付与して "user@host" としてsshに渡す
# - identity_file : 省略可。秘密鍵ファイル（pem等）のパス。指定すると ssh -i で渡す。~ はホームディレクトリに展開される
# - path          : 対象サーバ上のドキュメントルート（直下に .git または .svn がある想定）
# - pre_pull      : 省略可。ssh接続前にローカル（呼び出し元の作業ディレクトリ）で実行する任意コマンド。
#                    public/build のようなVCS管理外のビルド成果物をrsync等でリモートへ転送する用途を想定。
#                    非ゼロ終了で即座にデプロイを中断し、ssh接続自体を行わない。
#                    rsyncの接続先・認証情報はこのキーの中に自分で書く（host/passwordキーとは別物）。
# - post_pull     : pull/up成功後にリモートで実行する任意コマンド（省略可、pullと同一ssh接続内で実行）
# - password      : 省略可。鍵認証が無いホスト向けにsshパスワードを自動投入する（sshpassが必要）。
#                    未設定 or sshpass未インストール時は従来通り対話プロンプトにフォールバックする。
#
#                    【重要】password を書いた .deploy は必ずVCS管理から除外すること
#                    （git: .gitignore に `.deploy` を追加 / svn: svn:ignore プロパティに `.deploy` を追加）。
#                    除外しないと平文パスワードがリポジトリ履歴に残る。
#
# - log           : 省略可（未設定 or false で出力しない）。true にすると path 直下の deploy.log に追記。
#                    パス（例: ./logs/deploy.log）を指定するとそこに追記する（相対パスは path 基準）。
#                    pull/post_pull の出力をターミナル表示と同時にログファイルへも書き込む。
#                    ※リモートのログインシェルがbashであることが前提（exec > >(tee ...) を使用するため）
#
# host に "user@host" を直書きする書き方も互換のため使える（user キーとどちらか一方でよい）。
#
# セクション名（[45] や [prod] など）が deploy.sh の <target> 引数に対応する。

# host に "user@host" を直書きする例（gitプロジェクト・Laravel案件、password未使用）
[45]
host=deploy-user@192.168.123.45
path=/var/www/vhosts/example.com
post_pull=php artisan config:clear && php artisan view:clear && php artisan cache:clear

# ~/.ssh/config のHostエイリアスを使う例（User/Port/IdentityFileはエイリアス側で設定済み想定、post_pullなし）
# ~/.ssh/config側の例:
#   Host example-prod
#       HostName 203.0.113.20
#       User deploy-user
#       Port 22222
#       IdentityFile ~/.ssh/id_ed25519_example
# デプロイ履歴をログに残したいので log=true にして path 直下の deploy.log に追記する
[prod]
host=example-prod
path=/var/www/vhosts/example.com/current
log=true

# user / identity_file キーで ~/.ssh/config を使わずに完結させる例（EC2のpemキー等）
[ec2]
host=203.0.113.30
user=ec2-user
identity_file=~/.ssh/keys/example.pem
path=/var/www/vhosts/example.com

# Dockerコンテナで運用するプロジェクトの例（post_pullでビルド→既存コンテナ入れ替え→起動）
# docker run --name は同名コンテナが残っていると失敗するため、
# 先に `docker rm -f <name> || true`（無ければ黙って無視）で消してから起動する。
# remote_cmd全体は set -e 下で動くので、rmの失敗が && チェーンを止めないよう
# 単独では && で繋がず (docker rm -f ... || true) のように必ず正常終了させて挟む。
[docker]
host=203.0.113.40
path=/home/projects/docker
post_pull=docker build -t DOCKER_IMAGE_NAME . && (docker rm -f DOCKER_CONTAINER_NAME || true) && docker run -d --name DOCKER_CONTAINER_NAME --restart=always -p 80:8080 DOCKER_IMAGE_NAME

# public/build（Vite/Tailwind等のビルド成果物、VCS管理外）をrsyncで同期する例
# pre_pullでローカルbuild+rsyncを行ってから、ssh接続でコードをpullする（この順序が重要。
# 逆にするとコードだけ先に反映されて古いCSSのままの瞬間ができてしまう）
[stg2]
host=deploy-user@203.0.113.50
path=/var/www/vhosts/example.com
pre_pull=npm run build && rsync -av --delete public/build/ deploy-user@203.0.113.50:/var/www/vhosts/example.com/public/build/
post_pull=php artisan view:clear

# svn管理プロジェクトの例（鍵認証が無いため password でパスワード自動投入、post_pullでパーミッション調整）
# ※このセクションを含む .deploy は必ず ignore 対象にすること
[stg]
host=stg-user@203.0.113.10
path=/var/www/vhosts/legacy-app.example.com
password=xxxxxxxx
post_pull=chmod -R 775 storage && chown -R www-data:www-data storage
